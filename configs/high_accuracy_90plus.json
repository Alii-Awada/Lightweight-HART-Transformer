{
  "architecture": "HART",
  "dataset": "PAMAP2",
  "batch_size": 128,
  "localEpoch": 300,
  "projection_dim": 192,
  "frame_length": 16,
  "time_step": 16,
  "learningRate": 0.0005,
  "min_learning_rate": 5e-06,
  "warmup_ratio": 0.1,
  "weight_decay": 0.01,
  "clipnorm": 1.0,
  "dropout_rate": 0.15,
  "attention_dropout": 0.08,
  "mlp_dropout": 0.1,
  "token_dropout": 0.05,
  "drop_path_rate": 0.12,
  "use_ema": true,
  "ema_decay": 0.9999,
  "use_jitter": true,
  "jitter_sigma": 0.015,
  "use_mixup": false,
  "mixup_alpha": 0.0,
  "tokenBased": false,
  "hartEnhancedTokenizer": true
}
