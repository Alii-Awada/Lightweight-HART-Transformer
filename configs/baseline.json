{
  "architecture": "HART",
  "dataset": "PAMAP2",
  "batch_size": 256,
  "localEpoch": 200,
  "projection_dim": 192,
  "frame_length": 16,
  "time_step": 16,
  "learningRate": 0.001,
  "min_learning_rate": 1e-05,
  "warmup_ratio": 0.06,
  "weight_decay": 0.01,
  "clipnorm": 1.0,
  "dropout_rate": 0.2,
  "attention_dropout": 0.1,
  "mlp_dropout": 0.1,
  "token_dropout": 0.1,
  "drop_path_rate": 0.1,
  "use_ema": true,
  "ema_decay": 0.999,
  "use_jitter": true,
  "jitter_sigma": 0.02,
  "use_mixup": true,
  "mixup_alpha": 0.2,
  "tokenBased": false,
  "hartEnhancedTokenizer": true
}
