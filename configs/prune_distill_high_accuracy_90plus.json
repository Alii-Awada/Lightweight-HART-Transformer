{
  "batch_size": 128,
  "frame_length": 16,
  "time_step": 16,
  "base_projection_dim": 192,
  "base_filter_heads": 4,
  "conv_kernels": "3,7,15,31,31,31",

  "dropout_rate": 0.15,
  "attention_dropout": 0.08,
  "mlp_dropout": 0.1,
  "token_dropout": 0.05,
  "drop_path_rate": 0.12,
  "jitter_sigma": 0.015,
  "enhanced_tokenizer": true,
  "token_based": false,

  "weight_decay": 0.01,
  "clipnorm": 1.0,
  "min_learning_rate": 5e-6,
  "warmup_ratio": 0.1,

  "learning_rate": 1e-4,
  "cycles": 5,
  "prune_step": 0.1,
  "head_prune_step": 0.1,
  "epochs_per_cycle": 10,
  "temperature": 2.0,
  "kd_weight": 0.5
}
